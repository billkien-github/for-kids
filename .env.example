# Postgres (dùng chung cho service db và app)
POSTGRES_USER=forkids
POSTGRES_PASSWORD=change-me
POSTGRES_DB=forkids

# App
PORT=3000
# Cổng của start-public.cmd (bản build + ngrok), khác PORT để chạy song song với `pnpm dev`.
PUBLIC_PORT=3100
# Chỉ dùng khi chạy `pnpm dev` ngoài Docker; trong Docker, compose tự đặt DATABASE_URL trỏ tới service db.
# Chưa có Docker: DATABASE_URL=pglite:./data/pglite (Postgres nhúng, chỉ để dev)
DATABASE_URL=postgres://forkids:change-me@localhost:5432/forkids
UPLOADS_DIR=./data/uploads
# Cờ secure của cookie: mặc định auto (bật khi vào qua https như ngrok, tắt khi vào bằng http trong LAN).
# COOKIE_SECURE=auto

# Tài khoản phụ huynh đầu tiên, dùng cho lệnh seed
SEED_FAMILY_NAME=Nhà mình
SEED_PARENT_EMAIL=
SEED_PARENT_PASSWORD=
SEED_PARENT_PIN=

# ngrok (chỉ cần khi chạy với --profile tunnel)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
